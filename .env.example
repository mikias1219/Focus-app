# Copy to `.env` at this repo root (same folder as backend/ and frontend/).
# Backend loads ../.env when run from backend/; Next loads parent env via next.config.ts.

# --- Database (Prisma / Nest) ---
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/focusflow?schema=public

# --- Auth (Nest JWT) ---
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# --- API server ---
PORT=3000
FRONTEND_URL=http://localhost:3001

# --- Frontend (Next.js; must be prefixed NEXT_PUBLIC_) ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api
