# Copy to `.env.azure` in this folder (gitignored) and fill values before running `./deploy.sh`.
# Run `az login` and `az account set --subscription "<id>"` first.

AZURE_LOCATION=eastus2
AZURE_RG=focusflow-rg
# Short prefix for resource names (letters + numbers, lowercase, no spaces)
NAME_PREFIX=focusflow

# Must be globally unique (5–50 chars, alphanumeric). Example: focusflowacr2026
ACR_NAME=

# PostgreSQL admin password (strong; URL-safe characters preferred)
PG_ADMIN_PASSWORD=

# Optional: set explicit secrets (otherwise deploy.sh generates JWT secrets)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# Deploy Azure OpenAI + model deployment (requires quota in your subscription / region)
DEPLOY_OPENAI=true
